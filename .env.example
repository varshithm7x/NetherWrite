# ─── Supabase Configuration ───────────────────────────────────────────
# Create a free project at https://supabase.com, then open the SQL Editor
# and run the contents of supabase/schema.sql to set up your database.
#
# After that, go to Project Settings > API and copy your project URL
# and anon (public) key below.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: OAuth redirect URL.
# Defaults to window.location.origin in the browser if not set.
# Only needed for custom OAuth callback configurations.
# VITE_SUPABASE_REDIRECT_URL=https://your-project-id.supabase.co/auth/v1/callback
